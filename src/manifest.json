{
  "manifest_version": 3,
  "version": "2.5.0",
  "name": "GitHub Linker",
  "description": "增强 GitHub/GitLab 工作流，支持多 Org 用户映射和可选的飞书项目关联",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["github-assignee-fetch-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*/*"],
      "js": ["index.js"]
    },
    {
      "matches": ["*://*/*"],
      "js": ["sentry.js"]
    }
  ],
  "options_page": "options.html"
}
